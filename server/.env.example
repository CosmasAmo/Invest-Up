# ===================================================
# InvestUp Server Environment Configuration
# ===================================================

# Port & Environment
PORT=3000
NODE_ENV=production

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=investup_dbuser
DB_PASSWORD=your_database_password
DB_NAME=investup_dbname
MYSQL_URL=mysql://investup_dbuser:your_database_password@localhost:3306/investup_dbname

# Security Secrets
JWT_SECRET=your_super_secret_jwt_key_change_me
SESSION_SECRET=your_session_secret_key_change_me
COOKIE_SECRET=your_cookie_secret_key_change_me

# Domain URLs
SERVER_URL=https://backend.investuptrading.com
CLIENT_URL=https://investuptrading.com

# SMTP / Email Configuration
SMTP_HOST=indra.vivawebhost.com
SMTP_PORT=465
SMTP_USER=accounts@investuptrading.com
SMTP_PASS=your_email_password
SENDER_EMAIL=accounts@investuptrading.com

# Cloudinary (Optional, for profile images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# ===================================================
# OFFICIAL PAYMENT WALLET ADDRESSES
# These are the ONLY addresses used across the platform.
# They CANNOT be changed via the dashboard or any API.
# Replace with your actual company wallet addresses.
# ===================================================
WALLET_BINANCE=your_binance_pay_id_here
WALLET_TRC20=your_trc20_usdt_address_here
WALLET_BEP20=your_bep20_usdt_address_here
WALLET_ERC20=your_erc20_usdt_address_here
WALLET_OPTIMISM=your_optimism_usdt_address_here
